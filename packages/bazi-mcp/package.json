{
  "name": "@sylvantang/bazi-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "Bazi MCP Server for AI Destiny OS (primary path: ai-destiny-os core/astro engine)",
  "bin": { "bazi-mcp": "./dist/index.js" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --packages=external",
    "dev": "tsx watch src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  },
  "publishConfig": { "access": "public" }
}
