 {
  "source": "三命通会",
  "chapter": "论日主",
  "content": "日主者，八字之我也。四柱皆以日干为主，故又名日元、日主。",
  "tags": [
   "日主"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论格局",
  "content": "格局者，命之规模气象也。取格以月令为主，月令所藏何神，即取何格。",
  "tags": [
   "格局",
   "月令"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论用神",
  "content": "用神者，命之枢纽也。或扶或抑，或调候，或通关，取一为用，贯串全局。",
  "tags": [
   "用神"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论大运",
  "content": "大运者，阳男阴女顺行，阴男阳女逆行，自月柱起运，十年一运，关乎半生休咎。",
  "tags": [
   "大运"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论流年",
  "content": "流年者，太岁也。岁运并临，吉凶加倍；太岁当头坐，无喜恐有祸。",
  "tags": [
   "流年",
   "太岁"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论六十甲子",
  "content": "六十甲子纪年法：天干地支依次相配，甲子起，癸亥止，六十年循环一周。",
  "tags": [
   "甲子"
  ]
 }
