 {
  "source": "渊海子平",
  "chapter": "继善篇",
  "content": "人禀天地，命属阴阳。生居覆载之内，尽在五行之中。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "继善篇",
  "content": "欲知贵贱，先观月令乃提纲。次断吉凶，专用日干为本主。",
  "tags": [
   "提纲",
   "日主"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "继善篇",
  "content": "三元要成格局，四柱喜见财官。用神不可损伤，日主最宜健旺。",
  "tags": [
   "格局",
   "用神"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "继善篇",
  "content": "取用凭于生月，当推究于浅深；发觉在于日时，要消详于强弱。",
  "tags": [
   "用神",
   "旺衰"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "继善篇",
  "content": "官星正气，忌见刑冲。时上偏财，怕逢兄弟。",
  "tags": [
   "官",
   "财"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "继善篇",
  "content": "富而且贵，定因财旺生官。非夭即贫，必是身衰遇鬼。",
  "tags": [
   "财官",
   "旺衰"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "金玉赋",
  "content": "搜寻八字，专论财官。次究五行，须求气候。论财官之轻重，察气候之浅深。",
  "tags": [
   "财官",
   "调候"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "珞琭子赋",
  "content": "元一气兮先天，禀清浊兮自然。著三才以成象，播四气以为年。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "珞琭子赋",
  "content": "以干为禄，以向背定贫富；以支为命，详逆顺以循环。",
  "tags": [
   "禄命"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "万金赋",
  "content": "欲识五行生死诀，容易岂与凡人说。星中但以限为凭，子平只以运为诀。",
  "tags": [
   "大运"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "五言独步",
  "content": "有病方为贵，无伤不是奇。格中如去病，财禄两相随。",
  "tags": [
   "格局",
   "病药"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "论月令",
  "content": "月令者，命之提纲也。看命先看提纲，提纲得令，则其气最旺。",
  "tags": [
   "提纲",
   "月令"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论五行生克",
  "content": "五行相生：木生火，火生土，土生金，金生水，水生木。生我者为印绶，我生者为食伤。",
  "tags": [
   "五行",
   "相生"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论五行生克",
  "content": "五行相克：木克土，土克水，水克火，火克金，金克木。克我者为官杀，我克者为财星。",
  "tags": [
   "五行",
   "相克"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论天干五合",
  "content": "天干五合：甲己合化土，乙庚合化金，丙辛合化水，丁壬合化木，戊癸合化火。",
  "tags": [
   "天干",
   "合化"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论地支六合",
  "content": "地支六合：子丑合土，寅亥合木，卯戌合火，辰酉合金，巳申合水，午未合日月。",
  "tags": [
   "地支",
   "六合"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论三合局",
  "content": "地支三合局：申子辰合水局，亥卯未合木局，寅午戌合火局，巳酉丑合金局。",
  "tags": [
   "地支",
   "三合"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论六冲",
  "content": "地支六冲：子午冲，丑未冲，寅申冲，卯酉冲，辰戌冲，巳亥冲。",
  "tags": [
   "地支",
   "冲"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论三刑",
  "content": "地支三刑：寅刑巳、巳刑申、申刑寅为无恩之刑；丑刑戌、戌刑未、未刑丑为恃势之刑；子刑卯、卯刑子为无礼之刑。",
  "tags": [
   "地支",
   "刑"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论旺相休囚死",
  "content": "五行旺相休囚死：当令者旺，令生者相，生令者休，克令者囚，令克者死。",
  "tags": [
   "旺衰",
   "月令"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十干禄",
  "content": "十干禄位：甲禄在寅，乙禄在卯，丙戊禄在巳，丁己禄在午，庚禄在申，辛禄在酉，壬禄在亥，癸禄在子。",
  "tags": [
   "禄",
   "天干"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "长生：长生者，犹人之初生。万物发生向荣，如人始生而向长也。",
  "tags": [
   "十二长生",
   "长生"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "沐浴：沐浴者，犹人既生之后，沐浴以去垢。万物由生而长，如人处婴儿之沐浴也。",
  "tags": [
   "十二长生",
   "沐浴"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "冠带：冠带者，万物渐荣秀，如人具衣冠也。",
  "tags": [
   "十二长生",
   "冠带"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "临官：临官者，如人之临官也。万物成熟，如人出仕而有为也。",
  "tags": [
   "十二长生",
   "临官"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "帝旺：帝旺者，万物成熟，如人之兴旺也。",
  "tags": [
   "十二长生",
   "帝旺"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "衰：衰者，万物形衰，如人之气衰也。",
  "tags": [
   "十二长生",
   "衰"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "病：病者，万物病，如人之病也。",
  "tags": [
   "十二长生",
   "病"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "死：死者，万物死，如人之死也。",
  "tags": [
   "十二长生",
   "死"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "墓：墓者，万物收藏，如人之归墓也。",
  "tags": [
   "十二长生",
   "墓"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "绝：绝者，前气已绝，后气将续，如人之绝而复苏也。",
  "tags": [
   "十二长生",
   "绝"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "胎：胎者，天地之气交，如人受父母之气也。",
  "tags": [
   "十二长生",
   "胎"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十二长生",
  "content": "养：养者，如人之养于母腹也。",
  "tags": [
   "十二长生",
   "养"
  ]
 },
 {
