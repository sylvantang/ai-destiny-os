[
  {"source":"穷通宝鉴","chapter":"论木","content":"春月之木，犹有余寒。得火温暖，始无盘屈之患；藉水资扶，而有舒畅之美。","tags":["木","调候"]},
  {"source":"滴天髓","chapter":"何知章","content":"何知其人富？财气通门户。何知其人贵？官星有理会。","tags":["财","官"]},
  {"source":"三命通会","chapter":"论十神","content":"正官者，克我而与我异性者也。七杀者，克我而与我同性者也。","tags":["十神"]},
  {"source":"渊海子平","chapter":"继善篇","content":"人禀天地，命属阴阳。生居覆载之内，尽在五行之中。","tags":["总论"]},
  {"source":"穷通宝鉴","chapter":"论火","content":"夏月之火，势力并炎。得水盛而为祥，遇木助而增殃。","tags":["火","调候"]},
  {"source":"滴天髓","chapter":"体用","content":"道有体用，不可以一端论也。要在扶之抑之得其宜。","tags":["用神"]},
  {"source":"三命通会","chapter":"论纳音","content":"甲子乙丑海中金，丙寅丁卯炉中火，戊辰己巳大林木。","tags":["纳音"]},
  {"source":"渊海子平","chapter":"金玉赋","content":"五行得均平，富贵享遐龄。偏枯多夭折，刑克见孤贫。","tags":["五行"]},
  {"source":"穷通宝鉴","chapter":"论土","content":"秋月之土，子旺母衰。金多而耗盗其气，木盛须制伏纯良。","tags":["土","调候"]},
  {"source":"滴天髓","chapter":"形象","content":"形全者宜损其有余，形缺者宜补其不足。","tags":["格局"]}
]
