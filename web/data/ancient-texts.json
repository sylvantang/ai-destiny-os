   "调候"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人富？财气通门户。何知其人贵？官星有理会。",
  "tags": [
   "财",
   "官"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "正官者，克我而与我异性者也。七杀者，克我而与我同性者也。",
  "tags": [
   "十神"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "继善篇",
  "content": "人禀天地，命属阴阳。生居覆载之内，尽在五行之中。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论火",
  "content": "夏月之火，势力并炎。得水盛而为祥，遇木助而增殃。",
  "tags": [
   "火",
   "调候"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "体用",
  "content": "道有体用，不可以一端论也。要在扶之抑之得其宜。",
  "tags": [
   "用神"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论纳音",
  "content": "甲子乙丑海中金，丙寅丁卯炉中火，戊辰己巳大林木。",
  "tags": [
   "纳音"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "金玉赋",
  "content": "五行得均平，富贵享遐龄。偏枯多夭折，刑克见孤贫。",
  "tags": [
   "五行"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论土",
  "content": "秋月之土，子旺母衰。金多而耗盗其气，木盛须制伏纯良。",
  "tags": [
   "土",
   "调候"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "形象",
  "content": "形全者宜损其有余，形缺者宜补其不足。",
  "tags": [
   "格局"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论木",
  "content": "春月之木，犹有余寒。得火温暖，始无盘屈之患；藉水资扶，而有舒畅之美。",
  "tags": [
   "木",
   "春"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论木",
  "content": "夏月之木，根干叶燥。盘而且直，屈而已伸。欲其水盛而成滋润之力，诚不可少也。忌火旺而招焚化之忧。",
  "tags": [
   "木",
   "夏"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论木",
  "content": "秋月之木，气渐凄凉，形渐凋败。初秋火气未除，犹喜水土以相滋；霜降后不宜水盛，水盛则木漂；寒露节又喜火炎，火炎则木实。",
  "tags": [
   "木",
   "秋"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论木",
  "content": "冬月之木，盘屈在地。欲土多而培养，恶水盛而亡形。金纵多，克伐无害；火重见，温燠有功。",
  "tags": [
   "木",
   "冬"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论火",
  "content": "春月之火，母旺子相。势力并行，喜木生扶，不宜过旺，旺则火炎；欲水既济，不宜太多，多则火灭。",
  "tags": [
   "火",
   "春"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论火",
  "content": "夏月之火，势力并炎。得水制之，则为既济；遇木助之，则为伤身。",
  "tags": [
   "火",
   "夏"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论火",
  "content": "秋月之火，性息体休。得木生则有复明之庆，遇水克难逃陨灭之灾。土重而掩息其光，金多而损伤其势。",
  "tags": [
   "火",
   "秋"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论火",
  "content": "冬月之火，体绝形亡。喜木生而有救，遇水克以为殃。欲土制为荣，爱火比为利。",
  "tags": [
   "火",
   "冬"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论土",
  "content": "春月之土，其势最孤。喜火生扶，恶木太过；忌水泛滥，喜土比助。",
  "tags": [
   "土",
   "春"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论土",
  "content": "夏月之土，其势燥烈。得盛水滋润成功，忌旺火煅炼焦赤。木助火炎，生克不置；金得水滋，财禄有余。",
  "tags": [
   "土",
   "夏"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论土",
  "content": "秋月之土，子旺母衰。金多而耗盗其气，木盛须制伏纯良。火重而不厌，水泛而不祥。",
  "tags": [
   "土",
   "秋"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论土",
  "content": "冬月之土，外寒内温。水旺财丰，金多子秀。火盛有荣，木多无咎。再加土助尤佳，惟喜身强足寿。",
  "tags": [
   "土",
   "冬"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论金",
  "content": "春月之金，余寒未尽。贵乎火气为荣，性柔体弱，欲得厚土辅助。",
  "tags": [
   "金",
   "春"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论金",
  "content": "夏月之金，尤为柔弱。形质未备，更嫌死绝。火多而却为不厌，水盛而滋润呈祥。",
  "tags": [
   "金",
   "夏"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论金",
  "content": "秋月之金，当权得令。火来煅炼，遂成钟鼎之材；土多培养，反为顽浊之气。见水则精神越秀，逢木则琢削施威。",
  "tags": [
   "金",
   "秋"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论金",
  "content": "冬月之金，形寒性冷。木多则难施琢削之功，水盛而未免沉潜之患。土能制水，金体不寒；火来助土，母子成功。",
  "tags": [
   "金",
   "冬"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论水",
  "content": "春月之水，性滥滔淫。再逢水助，必有崩堤之势；若加土盛，则无泛涨之忧。喜金生扶，不宜金盛；欲火既济，不宜火炎。",
  "tags": [
   "水",
   "春"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论水",
  "content": "夏月之水，执性归源。时当涸际，欲得比肩。喜金生而助体，忌火旺而太炎。木盛则耗盗其气，土旺则克制其流。",
  "tags": [
   "水",
   "夏"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论水",
  "content": "秋月之水，母旺子相。表里晶莹，得金助则澄清，逢土旺则混浊。火多而财盛，木重而身荣。",
  "tags": [
   "水",
   "秋"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论水",
  "content": "冬月之水，司令当权。遇火则暖，逢土则归藏。金多反致无义，木盛是为有情。水太微则喜比为助，水太盛则喜土为堤。",
  "tags": [
   "水",
   "冬"
  ]
 },
 {
