   "癸",
   "调候",
   "用神"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论癸",
  "content": "癸日主生于九月（戌月）：调候用神取辛甲壬癸并用。",
  "tags": [
   "癸",
   "调候",
   "用神"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论癸",
  "content": "癸日主生于十月（亥月）：调候用神取庚辛戊丁并用。",
  "tags": [
   "癸",
   "调候",
   "用神"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论癸",
  "content": "癸日主生于十一月（子月）：调候用神取丙辛并用。",
  "tags": [
   "癸",
   "调候",
   "用神"
  ]
 },
 {
  "source": "穷通宝鉴",
  "chapter": "论癸",
  "content": "癸日主生于十二月（丑月）：调候用神取丙丁并用。",
  "tags": [
   "癸",
   "调候",
   "用神"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天道",
  "content": "欲识三元万法宗，先观帝载与神功。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "地道",
  "content": "坤元合德机缄通，五气偏全定吉凶。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "人道",
  "content": "戴天履地人为贵，顺则吉兮凶则悖。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "知命",
  "content": "要与人间开聋聩，顺逆之机须理会。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "理气",
  "content": "理承气行岂有常，进兮退兮宜抑扬。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "配合",
  "content": "配合干支仔细详，定人祸福与灾祥。",
  "tags": [
   "总论"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "甲木参天，脱胎要火。春不容金，秋不容土。火炽乘龙，水宕骑虎。地润天和，植立千古。",
  "tags": [
   "甲",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "乙木虽柔，刲羊解牛。怀丁抱丙，跨凤乘猴。虚湿之地，骑马亦忧。藤萝系甲，可春可秋。",
  "tags": [
   "乙",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "丙火猛烈，欺霜侮雪。能煅庚金，逢辛反怯。土众成慈，水猖显节。虎马犬乡，甲来成灭。",
  "tags": [
   "丙",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "丁火柔中，内性昭融。抱乙而孝，合壬而忠。旺而不烈，衰而不穷。如有嫡母，可秋可冬。",
  "tags": [
   "丁",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "戊土固重，既中且正。静翕动辟，万物司命。水润物生，火燥物病。若在艮坤，怕冲宜静。",
  "tags": [
   "戊",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "己土卑湿，中正蓄藏。不愁木盛，不畏水狂。火少火晦，金多金光。若要物旺，宜助宜帮。",
  "tags": [
   "己",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "庚金带煞，刚健为最。得水而清，得火而锐。土润则生，土干则脆。能赢甲兄，输于乙妹。",
  "tags": [
   "庚",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "辛金软弱，温润而清。畏土之叠，乐水之盈。能扶社稷，能救生灵。热则喜母，寒则喜丁。",
  "tags": [
   "辛",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "壬水通河，能泄金气。刚中之德，周流不滞。通根透癸，冲天奔地。化则有情，从则相济。",
  "tags": [
   "壬",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "天干论",
  "content": "癸水至弱，达于天津。得龙而运，功化斯神。不愁火土，不论庚辛。合戊见火，化象斯真。",
  "tags": [
   "癸",
   "天干"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "地支总论",
  "content": "阳支动且强，速达显灾祥。阴支静且专，否泰每经年。",
  "tags": [
   "地支"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "地支总论",
  "content": "生方怕动，库宜开，败地逢冲仔细推。",
  "tags": [
   "地支",
   "冲合"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人富？财气通门户。",
  "tags": [
   "财"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人贵？官星有理会。",
  "tags": [
   "官"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人贫？财神反不真。",
  "tags": [
   "财"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人贱？官星还不见。",
  "tags": [
   "官"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人吉？喜神为辅弼。",
  "tags": [
   "喜神"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人凶？忌神辗转攻。",
  "tags": [
   "忌神"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人寿？性定元神厚。",
  "tags": [
   "寿"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "何知章",
  "content": "何知其人夭？气浊神枯了。",
  "tags": [
   "夭"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "体用",
  "content": "道有体用，不可以一端论也。要在扶之抑之得其宜。",
  "tags": [
   "用神",
   "扶抑"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "精神",
  "content": "人有精神，不可以一偏求也。要在损之益之得其中。",
  "tags": [
   "中和"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "衰旺",
  "content": "能知衰旺之真机，其于三命之奥，思过半矣。",
  "tags": [
   "旺衰"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "中和",
  "content": "既识中和之正理，而于五行之妙，有全能焉。",
  "tags": [
   "中和"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "源流",
  "content": "何处起根源？流到何方住？机括此中求，知来亦知去。",
  "tags": [
   "源流"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "通关",
  "content": "关内有织女，关外有牛郎。此关若通也，相邀入洞房。",
  "tags": [
   "通关"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "官杀",
  "content": "官杀混杂来问我，有可有不可。",
  "tags": [
   "官杀"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "伤官",
  "content": "伤官见官果难辨，可见不可见。",
  "tags": [
   "伤官"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "清气",
  "content": "一清到底有精神，管取生平富贵真。澄浊求清清得去，时来寒谷也回春。",
  "tags": [
   "清浊"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "浊气",
  "content": "满盘浊气令人苦，一局清枯也苦人。半浊半清犹是可，多成多败度晨昏。",
  "tags": [
   "清浊"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "真神",
  "content": "令上寻其聚得真，假神休要乱真神。真神得用生平贵，用若无为碌碌人。",
  "tags": [
   "用神",
   "真假"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "假神",
  "content": "真假参差难辨论，不明不暗受邅迍。提纲不与真神照，暗处寻真也有真。",
  "tags": [
   "用神",
   "真假"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "寒暖",
  "content": "天道有寒暖，发育万物，人道得之，不可过也。",
  "tags": [
   "调候",
   "寒暖"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "燥湿",
  "content": "地道有燥湿，生成品汇，人道得之，不可偏也。",
  "tags": [
   "调候",
   "燥湿"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "隐显",
  "content": "吉神太露，起争夺之风；凶物深藏，成养虎之患。",
  "tags": [
   "隐显"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "众寡",
  "content": "强众而敌寡者，势在去其寡；强寡而敌众者，势在成乎众。",
  "tags": [
   "众寡"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "刚柔",
  "content": "刚柔不一也，不可制者，引其性情而已矣。",
  "tags": [
   "刚柔"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "顺逆",
  "content": "顺逆不齐也，不可逆者，顺其气势而已矣。",
  "tags": [
   "顺逆"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "形象",
  "content": "两气合而成象，象不可破也。五气聚而成形，形不可害也。",
  "tags": [
   "形象",
   "格局"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "形象",
  "content": "独象喜行化地，而化神要昌。全象喜行财地，而财神要旺。",
  "tags": [
   "形象",
   "格局"
  ]
 },
 {
  "source": "滴天髓",
  "chapter": "方局",
  "content": "方是方兮局是局，方要得方莫混局。",
  "tags": [
   "方局",
   "格局"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "甲木天干体象诗：甲木天干作首排，原无枝叶与根荄。欲存天地千年久，直向沙泥万丈埋。",
  "tags": [
   "甲",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "乙天干体象诗：乙木根荄种得深，只宜阳地不宜阴。漂浮最怕多逢水，刻断何当苦用金。",
  "tags": [
   "乙",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "丙天干体象诗：丙火明明一太阳，原从正大立纲常。洪光不独窥千里，巨焰犹能遍八荒。",
  "tags": [
   "丙",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "丁天干体象诗：丁火其形一烛灯，太阳相见夺光明。得时能铸千金铁，失令难镕一寸金。",
  "tags": [
   "丁",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "戊天干体象诗：戊土城墙堤岸同，振河及海要根重。柱中带合形还壮，日下乘虚势必崩。",
  "tags": [
   "戊",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "己天干体象诗：己土田园属四维，坤深万物为之基。水金旺处身还弱，火土功成局最奇。",
  "tags": [
   "己",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "庚天干体象诗：庚金顽钝性偏刚，火制功成怕水乡。夏产东南过煅炼，秋生西北亦光芒。",
  "tags": [
   "庚",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "辛天干体象诗：辛金珠玉性通灵，最爱阳和沙水清。成就不劳炎火煅，资扶偏爱湿泥生。",
  "tags": [
   "辛",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "壬天干体象诗：壬水汪洋并百川，漫流天下总无边。干支多聚成漂荡，火土重逢涸本源。",
  "tags": [
   "壬",
   "天干",
   "体象"
  ]
 },
 {
  "source": "渊海子平",
  "chapter": "十干体象",
  "content": "癸天干体象诗：癸水应非雨露么，根通亥子即江河。柱无坤坎还身弱，局有财官不尚多。",
  "tags": [
   "癸",
   "天干",
   "体象"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "正官者，克我而与我异性者也。甲见辛、乙见庚之类。官者，管也，约束自身，为贵气之首。",
  "tags": [
   "十神",
   "官"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "七杀者，克我而与我同性者也。甲见庚、乙见辛之类。杀者，克身最凶之物，制化得宜则为权柄。",
  "tags": [
   "十神",
   "杀"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "正财者，我克而与我异性者也。甲见己、乙见戊之类。财为养命之源，正财主勤俭积蓄。",
  "tags": [
   "十神",
   "财"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "偏财者，我克而与我同性者也。甲见戊、乙见己之类。偏财主慷慨，为众人之财。",
  "tags": [
   "十神",
   "财"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "正印者，生我而与我异性者也。甲见癸、乙见壬之类。印为生气之源，护身之物。",
  "tags": [
   "十神",
   "印"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "偏印者，生我而与我同性者也。甲见壬、乙见癸之类。偏印能夺食，故又名枭神。",
  "tags": [
   "十神",
   "印"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "食神者，我生而与我同性者也。甲见丙、乙见丁之类。食神主福寿，能制七杀。",
  "tags": [
   "十神",
   "食"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "伤官者，我生而与我异性者也。甲见丁、乙见丙之类。伤官主才华，伤官见官为祸百端。",
  "tags": [
   "十神",
   "伤"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "比肩者，与我同类而同性者也。甲见甲、乙见乙之类。比肩主帮扶，亦主分夺。",
  "tags": [
   "十神",
   "比"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论十神",
  "content": "劫财者，与我同类而异性者也。甲见乙、乙见甲之类。劫财主破耗，能合杀留官。",
  "tags": [
   "十神",
   "劫"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论天乙贵人",
  "content": "天乙者，乃天上之神。在紫微垣，与太乙并列，事天皇大帝，下游三辰。其神最尊贵，所至之处，一切凶煞隐然而避。",
  "tags": [
   "神煞",
   "贵人"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论文昌",
  "content": "文昌者，乃食神之临官长生之所。主聪明过人，逢凶化吉。",
  "tags": [
   "神煞",
   "文昌"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论华盖",
  "content": "华盖者，乃三合之墓库也。华盖主孤独好学，宜僧道艺术。",
  "tags": [
   "神煞",
   "华盖"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论咸池",
  "content": "咸池者，又名桃花煞。乃五行沐浴之地，主风流酒色。",
  "tags": [
   "神煞",
   "桃花"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论驿马",
  "content": "驿马者，乃三合之冲也。申子辰马在寅之类。主奔波迁移。",
  "tags": [
   "神煞",
   "驿马"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论羊刃",
  "content": "羊刃者，禄前一位也。甲刃在卯、丙戊刃在午之类。刃主刚烈，羊刃驾杀掌兵权。",
  "tags": [
   "神煞",
   "羊刃"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论空亡",
  "content": "空亡者，乃旬中不遇之辰。甲子旬中戌亥空之类。空亡之地，吉神减力，凶神无力。",
  "tags": [
   "神煞",
   "空亡"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论魁罡",
  "content": "魁罡者，乃庚辰、庚戌、壬辰、戊戌四日也。魁罡主聪敏刚断，忌刑冲。",
  "tags": [
   "神煞",
   "魁罡"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论将星",
  "content": "将星者，乃三合之旺神。申子辰将星在子。将星文武两相宜，禄重权高足可知。",
  "tags": [
   "神煞",
   "将星"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论金舆",
  "content": "金舆者，乃禄前二位。金舆主福泽，得妻财之助。",
  "tags": [
   "神煞",
   "金舆"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论天月二德",
  "content": "天德月德者，乃天地之德秀之气。人命值之，主心地慈祥，逢凶化吉。",
  "tags": [
   "神煞",
   "德"
  ]
 },
 {
  "source": "三命通会",
  "chapter": "论亡神劫煞",
  "content": "亡神劫煞，乃三合之绝败之地。主破败刑伤，得制则掌威权。",
  "tags": [
   "神煞",
   "劫煞"
  ]
 },
